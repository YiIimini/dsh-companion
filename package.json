{
  "name": "dsh-companion",
  "version": "2.1.0",
  "description": "One desk companion for DeepSeek Harness, replacing five overlapping pet plugins: three built-in SVG characters plus drop-in image skins, a durable position, a presence driven by real session events, and an optional companion agent preset. 统一桌宠：内置三角色 + 拖入自己的图片当皮肤，记住位置，按真实会话事件切换状态。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "companion",
    "mascot"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
